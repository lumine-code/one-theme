{
  "name": "one-theme",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "The One day and night UI and syntax themes.",
  "keywords": [
    "light",
    "dark",
    "syntax",
    "day-night",
    "color-scheme"
  ],
  "repository": "https://github.com/lumine-code/one-theme",
  "bugs": {
    "url": "https://github.com/lumine-code/one-theme/issues"
  },
  "license": "MIT",
  "main": "lib/main",
  "files": [
    "lib",
    "spec",
    "styles"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "themes": [
    {
      "name": "one-day-ui",
      "theme": "ui",
      "styles": [
        "styles/ui",
        "styles/one-ui",
        "styles/day-ui"
      ]
    },
    {
      "name": "one-day-syntax",
      "theme": "syntax",
      "styles": [
        "styles/syntax",
        "styles/day-syntax"
      ]
    },
    {
      "name": "one-night-ui",
      "theme": "ui",
      "styles": [
        "styles/ui",
        "styles/one-ui",
        "styles/night-ui"
      ]
    },
    {
      "name": "one-night-syntax",
      "theme": "syntax",
      "styles": [
        "styles/syntax",
        "styles/night-syntax"
      ]
    }
  ],
  "themePacks": [
    {
      "name": "One",
      "light": [
        "one-day-ui",
        "one-day-syntax"
      ],
      "dark": [
        "one-night-ui",
        "one-night-syntax"
      ]
    }
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "configSchema": {
    "tabSizing": {
      "title": "Tab Sizing",
      "description": "In Even mode all tabs will be the same size. Great for quickly closing many tabs. In Maximum mode the tabs will expand to take up the full width. In Minimum mode the tabs will only take as little space as needed and also show longer file names.",
      "type": "string",
      "enum": [
        "Even",
        "Maximum",
        "Minimum"
      ],
      "default": "Even"
    },
    "tabCloseButton": {
      "title": "Tab Close Button",
      "description": "Choose the position of the close button shown in tabs.",
      "type": "string",
      "enum": [
        "Left",
        "Right"
      ],
      "default": "Right"
    },
    "hideDockButtons": {
      "title": "Hide Dock Toggle Buttons",
      "description": "Note: When hiding the toggle buttons, opening a dock needs to be done by using the keyboard or other alternatives.",
      "type": "boolean",
      "default": false
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
